# Contact form email delivery (https://resend.com). Without these, the form
# logs submissions in development and shows a "please call us" fallback in production.
RESEND_API_KEY=
# A sender on a domain you've verified in Resend, e.g. "Revolve Therapy <website@revolvetherapy.ca>"
CONTACT_FROM_EMAIL=
# Where enquiries are delivered. Defaults to the clinic email in src/content/site.ts.
CONTACT_TO_EMAIL=
